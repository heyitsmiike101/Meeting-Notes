  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "description": "Accent-filled action; one per view.",
      "html": "<button class=\"ds-btn-primary\">Generate notes</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:32px;padding:0 12px;border:1px solid #3b5bdb;border-radius:6px;background:#3b5bdb;color:#fff;font:500 .8125rem/1 Inter,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color .15s,border-color .15s,color .15s}.ds-btn-primary:hover{background:#3352c7;border-color:#3352c7}.ds-btn-primary:active{background:#2c47ad;border-color:#2c47ad}.ds-btn-primary:focus-visible{outline:2px solid #3b5bdb;outline-offset:2px}",
      "refersTo": "button-primary"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "description": "Default button: page fill, strong hairline.",
      "html": "<button class=\"ds-btn\">Copy notes</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:32px;padding:0 12px;border:1px solid #d0d5dd;border-radius:6px;background:#fff;color:#171a1f;font:500 .8125rem/1 Inter,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color .15s,border-color .15s,color .15s}.ds-btn:hover{background:rgba(16,24,40,.05)}.ds-btn:active{background:rgba(16,24,40,.08)}.ds-btn:focus-visible{outline:2px solid #3b5bdb;outline-offset:2px}",
      "refersTo": "button-secondary"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "description": "Quiet toolbar action.",
      "html": "<button class=\"ds-btn-ghost\">Retranscribe</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:32px;padding:0 12px;border:1px solid transparent;border-radius:6px;background:transparent;color:#4a5262;font:500 .8125rem/1 Inter,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color .15s,border-color .15s,color .15s}.ds-btn-ghost:hover{background:rgba(16,24,40,.05);color:#171a1f}.ds-btn-ghost:focus-visible{outline:2px solid #3b5bdb;outline-offset:2px}",
      "refersTo": "button-ghost"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "description": "Explicit destructive action; red only in text and border.",
      "html": "<button class=\"ds-btn-danger\">Delete meeting</button>",
      "css": ".ds-btn-danger{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:32px;padding:0 12px;border:1px solid #f0c4c1;border-radius:6px;background:#fff;color:#c0322c;font:500 .8125rem/1 Inter,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color .15s,border-color .15s,color .15s}.ds-btn-danger:hover{background:#fdf0ef}.ds-btn-danger:focus-visible{outline:2px solid #3b5bdb;outline-offset:2px}",
      "refersTo": "button-danger"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "description": "36px field with accent border and halo on focus.",
      "html": "<input class=\"ds-input\" type=\"text\" placeholder=\"Meeting name\">",
      "css": ".ds-input{width:260px;min-height:36px;padding:6px 10px;border:1px solid #d0d5dd;border-radius:6px;background:#fff;color:#171a1f;font:400 .875rem/1.4 Inter,ui-sans-serif,system-ui,sans-serif;transition:border-color .15s,box-shadow .15s}.ds-input::placeholder{color:#5f6b7d}.ds-input:hover{border-color:#5f6b7d}.ds-input:focus{outline:none;border-color:#3b5bdb;box-shadow:0 0 0 3px rgba(59,91,219,.09)}",
      "refersTo": "input"
    },
    {
      "name": "Sidebar Nav",
      "kind": "nav",
      "description": "Slim sidebar links; current page uses the active overlay.",
      "html": "<nav class=\"ds-nav\"><a href=\"#\" aria-current=\"page\"><svg class=\"ds-ic\" viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 5h.01M3 12h.01M3 19h.01M8 5h13M8 12h13M8 19h13\"/></svg>Meetings</a><a href=\"#\"><svg class=\"ds-ic\" viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8\"/><path d=\"M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/></svg>Home</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:2px;width:216px;padding:12px;background:#f6f7f9;border:1px solid #e4e7ec;border-radius:8px}.ds-nav a{display:flex;align-items:center;gap:10px;height:32px;padding:0 8px;border-radius:6px;color:#4a5262;font:500 .875rem Inter,ui-sans-serif,system-ui,sans-serif;text-decoration:none;transition:background-color .15s,color .15s}.ds-nav a:hover{background:rgba(16,24,40,.05);color:#171a1f}.ds-nav a[aria-current=page]{background:rgba(16,24,40,.08);color:#171a1f}.ds-nav a:focus-visible{outline:2px solid #3b5bdb;outline-offset:2px}.ds-ic{flex:none}",
      "refersTo": "sidebar"
    },
    {
      "name": "Status Badges",
      "kind": "chip",
      "description": "Neutral pill with a 6px colored dot: done, running, error.",
      "html": "<span class=\"ds-badge done\"><i class=\"ds-dot\"></i>Notes ready</span> <span class=\"ds-badge running\"><i class=\"ds-dot\"></i>Transcribing</span> <span class=\"ds-badge error\"><i class=\"ds-dot\"></i>Failed</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;gap:6px;height:22px;padding:0 9px 0 8px;border:1px solid #e4e7ec;border-radius:11px;background:#fff;color:#4a5262;font:500 .75rem Inter,ui-sans-serif,system-ui,sans-serif;white-space:nowrap}.ds-dot{width:6px;height:6px;border-radius:50%;background:#5f6b7d}.ds-badge.done .ds-dot{background:#2b9a66}.ds-badge.running .ds-dot{background:#3b5bdb;animation:ds-pulse 1.6s ease-in-out infinite}.ds-badge.error{color:#c0322c}.ds-badge.error .ds-dot{background:#d13b34}@keyframes ds-pulse{0%,100%{opacity:1}50%{opacity:.35}}",
      "refersTo": "badge"
    },
    {
      "name": "Meeting Row",
      "kind": "custom",
      "description": "Library row: title, sub-line, status badge; hover overlay, selected accent wash.",
      "html": "<div class=\"ds-row\"><div class=\"ds-main\"><span class=\"ds-title\">Weekly sync</span><span class=\"ds-sub\">Sep 28, 2026 · 42 min</span></div><span class=\"ds-badge\"><i class=\"ds-dot\"></i>Notes ready</span></div>",
      "css": ".ds-row{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:14px;min-height:56px;width:480px;padding:9px 12px;border-bottom:1px solid #e4e7ec;background:#fff;cursor:pointer;transition:background-color .12s}.ds-row:hover{background:rgba(16,24,40,.05)}.ds-main{min-width:0}.ds-title{display:block;color:#171a1f;font:500 .875rem Inter,ui-sans-serif,system-ui,sans-serif}.ds-sub{display:block;color:#4a5262;font:400 .8125rem Inter,ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums}.ds-badge{display:inline-flex;align-items:center;gap:6px;height:22px;padding:0 9px 0 8px;border:1px solid #e4e7ec;border-radius:11px;background:#fff;color:#4a5262;font:500 .75rem Inter,ui-sans-serif,system-ui,sans-serif}.ds-dot{width:6px;height:6px;border-radius:50%;background:#2b9a66}",
      "refersTo": "meeting-row"
    },
    {
      "name": "Theme Switcher",
      "kind": "custom",
      "description": "Segmented System / Light / Dark control.",
      "html": "<div class=\"ds-seg\"><label class=\"ds-opt\"><input type=\"radio\" name=\"t\">System</label><label class=\"ds-opt on\"><input type=\"radio\" name=\"t\" checked>Light</label><label class=\"ds-opt\"><input type=\"radio\" name=\"t\">Dark</label></div>",
      "css": ".ds-seg{display:inline-flex;padding:2px;gap:2px;background:rgba(16,24,40,.08);border-radius:8px}.ds-opt{position:relative;display:inline-flex;align-items:center;height:28px;padding:0 10px;border-radius:6px;color:#4a5262;font:500 .8125rem Inter,ui-sans-serif,system-ui,sans-serif;cursor:pointer}.ds-opt input{position:absolute;inset:0;margin:0;opacity:0;cursor:pointer}.ds-opt:hover{color:#171a1f}.ds-opt.on{background:#fff;color:#171a1f;box-shadow:0 0 0 1px #e4e7ec,0 1px 2px rgba(16,24,40,.08)}"
